    "spread_pct": 4.9,
    "h2d_p50_1c_ms_min": 0.466,
    "h2d_p50_1c_ms_max": 0.559,
    "out_bytes_min": 3920,
    "out_bytes_max": 3999968,
    "output_sweep_x": 1020.4,
    "note": "Inference and H2D ~constant across the 1020.4x output-size sweep -> compute and input transfer are the FIXED variables; only D2H (output) is swept (D2H itself spans ~126x in time, less than output size because a fixed ~0.14ms transfer-overhead floor dominates at small output)."
  },
  "transition": {
    "compute_bound_plateau": "cout<=163 (out<=125KB): scaling ~2.98x near-linear, jobs 33/33/33",
    "transition_band": "out ~250KB-1MB: scaling 1.99x->1.21x, core2 progressively starved",
    "d2h_bound": "out>=~2MB: scaling ~1.00x flat, one core hogs link (93/6/0 -> 98/2/0, matches crossover-axis yolo26n 472/28/2)",
    "intrinsic_crossover_out_bytes": 1095949,
    "intrinsic_crossover_note": "D2H p50 == fixed Inference (2.70ms) -> a SINGLE inference becomes D2H-bound (~1.05 MB output)",
    "link_saturation_onset_out_bytes": 326377,
    "link_saturation_note": "D2H == Inference/3 -> 3 cores can no longer all be fed by the one shared PCIe link, 3c/1c scaling starts breaking (~319 KB)",
    "band_width_x": 3.36,
    "band_width_note": "transition band spans ~3.4x in output size ~= N_cores (3): N cores share one D2H link, so multi-core throughput saturates at 1/N the per-core D2H that bounds a single inference",
    "d2h_linear_fit": {
      "ms_per_MB": 2.456,
      "intercept_ms": 0.137,
      "region": "cout<=1276 (out<=1MB); D2H turns super-linear above ~2MB"
    }
  },
  "headline": {
    "scaling_span": "3c/1c core-scaling traces 2.98x (compute-bound) -> 1.00x (D2H-bound) monotonically across a 1020.4x output-size sweep at FIXED compute",
    "vs_crossover_axis": "refines 274bffa: the regime boundary is not a knife-edge but a ~3x-wide band (= N_cores), because output size sets D2H and N cores share one PCIe link"
  },
