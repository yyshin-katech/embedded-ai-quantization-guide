{
  "inputs": { "images": [1, 3, 640, 640] },
  "calibration_num": 100,
  "calibration_method": "ema",
  "default_loader": {
    "dataset_path": "<CALIB_PNG_DIR>",
    "file_extensions": ["png"],
    "preprocessings": [
      { "convertColor": { "form": "BGR2RGB" } },
      { "div": { "x": 255 } },
      { "transpose": { "axis": [2, 0, 1] } },
      { "expandDim": { "axis": 0 } }
    ]
  }
}
